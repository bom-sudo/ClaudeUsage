<UserControl
    x:Class="ClaudeUsage.Views.Controls.SkeletonBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Name="PulseStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="Block"
                Storyboard.TargetProperty="Opacity"
                From="0.55" To="1.0" Duration="0:0:0.9"
                AutoReverse="True"
                RepeatBehavior="Forever"
                EnableDependentAnimation="True" />
        </Storyboard>
    </UserControl.Resources>

    <Border
        x:Name="Block"
        Background="{ThemeResource ControlFillColorSecondaryBrush}"
        CornerRadius="{StaticResource ControlCornerRadiusSmall}"
        Loaded="OnLoaded"
        Unloaded="OnUnloaded" />
</UserControl>
