<Application
    x:Class="ClaudeUsage.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ClaudeUsage.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <conv:BoolNegationConverter x:Key="BoolNegationConverter" />
            <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <conv:UsageStateToBrushConverter x:Key="UsageStateToBrushConverter" />
            <conv:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrushConverter" />
            <conv:DoubleToPercentStringConverter x:Key="DoubleToPercentStringConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
