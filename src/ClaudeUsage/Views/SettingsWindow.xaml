<Window
    x:Class="ClaudeUsage.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:ClaudeUsage.ViewModels"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,8,0">
            <TextBlock Text="Settings" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20,0,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">

                <StackPanel Spacing="8">
                    <TextBlock Text="API Configuration" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <controls:SettingsCard Header="Demo Mode" Description="Use realistic sample data instead of calling a real endpoint. No network requests are made while enabled.">
                        <ToggleSwitch IsOn="{Binding DemoModeEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="API Endpoint" Description="HTTPS endpoint returning usage data in the documented JSON shape (see README).">
                        <TextBox Width="220" PlaceholderText="https://your-endpoint/usage" Text="{Binding ApiEndpoint, Mode=TwoWay}" IsEnabled="{Binding DemoModeEnabled, Converter={StaticResource BoolNegationConverter}}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="API Key" Description="Stored in the Windows Credential Locker — never written to disk as plain text.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PasswordBox Width="200" PlaceholderText="Enter a new API key" Password="{Binding ApiKeyInput, Mode=TwoWay}" />
                            <TextBlock Text="Key stored" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding HasStoredApiKey, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button Content="Clear" Command="{Binding ClearApiKeyCommand}" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Connection">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConnectionTestStatusText}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="180" />
                            <Button Content="Test Connection" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding IsTestingConnection, Converter={StaticResource BoolNegationConverter}}" />
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <controls:SettingsCard Header="Theme">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <RadioButton Content="System" GroupName="ThemeGroup" IsChecked="{Binding Theme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=System, Mode=TwoWay}" />
                            <RadioButton Content="Light" GroupName="ThemeGroup" IsChecked="{Binding Theme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=TwoWay}" />
                            <RadioButton Content="Dark" GroupName="ThemeGroup" IsChecked="{Binding Theme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=TwoWay}" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Transparency" Description="Controls the Mica/Acrylic tint strength.">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Slider Width="140" Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding TransparencyLevel, Mode=TwoWay}" />
                            <TextBlock Text="{Binding TransparencyLevel, Converter={StaticResource DoubleToPercentStringConverter}}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Width="36" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Animations">
                        <ToggleSwitch IsOn="{Binding AnimationsEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Compact Mode">
                        <ToggleSwitch IsOn="{Binding CompactMode, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Refresh" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <controls:SettingsCard Header="Automatic Refresh Interval">
                        <ComboBox x:Name="RefreshIntervalCombo" Width="160" SelectionChanged="OnRefreshIntervalChanged">
                            <ComboBoxItem Content="30 seconds" Tag="Seconds30" />
                            <ComboBoxItem Content="1 minute" Tag="Minute1" />
                            <ComboBoxItem Content="5 minutes" Tag="Minutes5" />
                            <ComboBoxItem Content="15 minutes" Tag="Minutes15" />
                            <ComboBoxItem Content="Disabled" Tag="Disabled" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Daily Token Limit" Description="Used to compute the usage-vs-limit percentage.">
                        <NumberBox Width="140" Value="{Binding DailyTokenLimit, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="1000" />
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Notifications" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <controls:SettingsCard Header="Usage Threshold Alerts">
                        <ToggleSwitch IsOn="{Binding NotificationsEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Alert Thresholds" Description="Notify when daily usage crosses these levels.">
                        <ItemsControl ItemsSource="{Binding NotificationThresholdOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:NotificationThresholdOption">
                                    <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Startup &amp; Advanced" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <controls:SettingsCard Header="Start ClaudeUsage with Windows">
                        <ToggleSwitch IsOn="{Binding StartWithWindows, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Verbose Logging" Description="Only recommended for troubleshooting — disabled by default in Release builds.">
                        <ToggleSwitch IsOn="{Binding VerboseLoggingEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </controls:SettingsCard>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="20,12" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Saved" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Grid.Column="1" Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</Window>
