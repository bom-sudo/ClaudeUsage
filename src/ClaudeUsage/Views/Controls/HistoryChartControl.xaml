<UserControl
    x:Class="ClaudeUsage.Views.Controls.HistoryChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" MinHeight="90">
        <Polygon x:Name="FillPolygon" Opacity="0.16" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        <Polyline
            x:Name="LinePolyline"
            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
            StrokeThickness="2"
            StrokeLineJoin="Round"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round" />

        <TextBlock
            x:Name="EmptyState"
            Text="No history yet"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
